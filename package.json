{
  "name": "pi-omniroute-bridge",
  "version": "0.1.0",
  "description": "Pi extension that onboards OmniRoute and keeps Pi custom models synced from OmniRoute /v1/models.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-omniroute-bridge": "bin/pi-omniroute-bridge.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "install:pi": "node ./bin/pi-omniroute-bridge.mjs install",
    "sync:dsh": "node ./bin/dsh-omniroute-sync.mjs",
    "dev:link": "mkdir -p ~/.pi/agent/extensions && ln -sf \"$PWD/src/index.ts\" ~/.pi/agent/extensions/pi-omniroute-bridge.ts"
  },
  "keywords": [
    "pi",
    "omniroute",
    "extension",
    "models"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "host-pi-ai": "npm:@earendil-works/pi-ai@^0.99.1",
    "host-pi-coding-agent": "npm:@earendil-works/pi-coding-agent@^0.99.1"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ]
}
