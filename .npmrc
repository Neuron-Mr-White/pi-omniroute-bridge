# Keep host-provided packages (@earendil-works/pi-ai, @earendil-works/pi-coding-agent)
# out of node_modules. Pi maps bare imports of host packages to its own modules at
# runtime; a physical local copy would shadow them and create duplicate runtime modules.
# Types are provided by the aliased devDependencies (host-pi-ai, host-pi-coding-agent)
# wired up via tsconfig "paths".
legacy-peer-deps=true
